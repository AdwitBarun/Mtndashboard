                    <Radar name="Segment Avg" dataKey="avg" stroke="#94A3B8" fill="#94A3B8" fillOpacity={0.1} strokeWidth={2} strokeDasharray="4 4" />
                    <Tooltip content={<CustomTooltip />} />
                    <Legend wrapperStyle={{ fontSize: '10px', paddingTop: '10px' }} />
                  </RadarChart>
                </ResponsiveContainer>
              </div>

              <div className="mt-4 mb-4 overflow-hidden rounded-lg border border-gray-100">
                <table className="w-full text-xs text-left">
                  <thead className="bg-gray-50 text-gray-500 font-semibold uppercase text-[10px]">
                    <tr>
                      <th className="px-3 py-2">Dimension</th>
                      <th className="px-3 py-2 text-right">Customer</th>
                      <th className="px-3 py-2 text-right">Avg</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-100 bg-white">
                    {radarData.map((row) => (
                      <tr key={row.subject} className="hover:bg-gray-50">
                        <td className="px-3 py-1.5 font-medium text-gray-900">{row.subject}</td>
                        <td className="px-3 py-1.5 text-right font-bold" style={{ color: "#7A1230" }}>{row.customer}</td>
                        <td className="px-3 py-1.5 text-right text-gray-500">{row.avg}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div className="mt-auto bg-rose-50/50 border border-rose-100 rounded-xl p-3 flex gap-3">
                <div className="text-rose-500 mt-0.5"><Activity size={16} /></div>
                <p className="text-xs text-rose-900 font-medium leading-relaxed">
                  "Customer significantly over-indexes in streaming, recharge activity and household engagement, indicating strong cross-sell potential."
                </p>
              </div>
            </div>

          </div>
        </div>

        {/* FULL WIDTH INSIGHTS SECTION */}
        <div className="grid grid-cols-4 gap-4 mb-6">
          <div className="bg-white rounded-xl border shadow-sm p-4 flex items-center justify-between" style={{ borderColor: "#E2E2E6" }}>
            <div>
              <div className="text-xs font-semibold text-gray-500 mb-1">Data Growth</div>
              <div className="text-xl font-bold text-gray-900">79 GB</div>
            </div>
            <div className="bg-emerald-50 px-2 py-1 rounded text-emerald-700 text-xs font-bold flex items-center gap-1">
              <TrendingUp size={12} /> 22% QoQ
            </div>
          </div>
          <div className="bg-white rounded-xl border shadow-sm p-4 flex items-center justify-between" style={{ borderColor: "#E2E2E6" }}>
            <div>
              <div className="text-xs font-semibold text-gray-500 mb-1">Loyalty</div>
              <div className="text-xl font-bold text-gray-900">32 Months</div>
            </div>
            <div className="bg-blue-50 px-2 py-1 rounded text-blue-700 text-xs font-bold">
              Top Tier
            </div>
          </div>
          <div className="bg-white rounded-xl border shadow-sm p-4 flex items-center justify-between" style={{ borderColor: "#E2E2E6" }}>
            <div>
              <div className="text-xs font-semibold text-gray-500 mb-1">Family Engagement</div>
              <div className="text-xl font-bold text-gray-900">4 Members</div>
            </div>
            <div className="bg-indigo-50 px-2 py-1 rounded text-indigo-700 text-xs font-bold flex items-center gap-1">
              <Users size={12} /> Active
            </div>
          </div>
          <div className="bg-white rounded-xl border shadow-sm p-4 flex items-center justify-between" style={{ borderColor: "#E2E2E6" }}>
            <div>
              <div className="text-xs font-semibold text-gray-500 mb-1">Travel Activity</div>
              <div className="text-xl font-bold text-gray-900">9 Trips</div>
            </div>
            <div className="bg-amber-50 px-2 py-1 rounded text-amber-700 text-xs font-bold flex items-center gap-1">
              <Plane size={12} /> Last Qtr
            </div>
          </div>
        </div>

        {/* CTA AREA */}
        <div className="bg-gradient-to-r from-gray-900 to-[#7A1230] rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 text-white shadow-lg">
          <div className="max-w-2xl">
            <h2 className="text-2xl font-bold mb-2">{STAGE_PREVIEW_INFO.title}</h2>
            <p className="text-white/80 text-sm leading-relaxed">{STAGE_PREVIEW_INFO.subtitle}</p>
          </div>
          <button
            onClick={() => navigate(`/hub/${customer.id}/usage`, { state: { explorerSearch } })}
            className="shrink-0 bg-white text-[#7A1230] px-8 py-4 rounded-xl text-sm font-bold transition-all hover:bg-gray-100 hover:shadow-xl flex items-center gap-2"
          >
            Continue to Sense Stage <ArrowLeft className="rotate-180" size={16} />
          </button>
        </div>

      </div>
    </Layout>
  );
}
